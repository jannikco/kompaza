# Application
APP_NAME="Kompaza"
APP_URL=http://localhost:8000
APP_ENV=development
APP_DEBUG=true
PLATFORM_DOMAIN=kompaza.com

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kompaza
DB_USERNAME=kompaza
DB_PASSWORD=your_password_here

# SMTP2GO Email Service (platform default) — verify kompaza.com as a sender domain in SMTP2GO
SMTP2GO_API_KEY=
# Optional: Brevo (only if a tenant or platform is still configured for Brevo)
BREVO_API_KEY=
BREVO_LIST_ID=
MAIL_FROM_ADDRESS=info@kompaza.com
MAIL_FROM_NAME="Kompaza"

# Stripe (platform billing)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Impersonation
APP_SECRET=random-secret-here

# OpenAI (legacy lead-magnet generation)
OPENAI_API_KEY=

# SpaceXAI / xAI — preferred for new LLM features (automation suggestions)
# https://console.x.ai
XAI_API_KEY=

# Security
CSRF_TOKEN_NAME=csrf_token

# Cron secret — required to call /api/cron/* endpoints (abandoned carts, email sequences,
# membership events). Generate with: php -r "echo bin2hex(random_bytes(32));"
# Call crons as: curl -s "https://<tenant>.kompaza.com/api/cron/<job>?key=$CRON_SECRET"
CRON_SECRET=

# Outreach — LinkedIn agent platform
#
# Encrypts LinkedIn session cookies at rest. MUST be 32 random bytes, base64-encoded:
#   php -r "echo base64_encode(sodium_crypto_secretbox_keygen()), PHP_EOL;"
#
# Without it, connecting a LinkedIn account fails closed — it will never silently
# fall back to storing the cookie in plaintext. Back this key up SEPARATELY from the
# database: losing it means every tenant must re-pair their LinkedIn account, and
# keeping it in the same backup as the database defeats the point of encrypting.
OUTREACH_ENCRYPTION_KEY=
# Set to the old key during a rotation so existing rows keep decrypting. Remove it
# once scripts/outreach-encrypt-cookies.php --rotate reports zero rows on the old key.
OUTREACH_ENCRYPTION_KEY_PREVIOUS=
# Milliseconds a synchronous browser-relay call waits for the extension to respond.
OUTREACH_RELAY_TIMEOUT_MS=8000

# Superadmin
SUPERADMIN_EMAIL=jh@profectify.com
